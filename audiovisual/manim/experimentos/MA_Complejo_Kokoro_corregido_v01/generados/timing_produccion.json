    },
    {
      "id": "parabolas",
      "texto": "Las rectas horizontales y verticales, salvo los ejes, se convierten en parábolas.",
      "inicio": 17.8,
      "fin_voz": 22.782,
      "fin": 25.3,
      "audio": "generados\\audio\\cue-04-parabolas-em_alex.wav",
      "sha256": "403a00091b31d99ad1692d150c6cba075e488e8b83e49c56db6c12099f34bcb1"
    },
    {
      "id": "ejes",
      "texto": "Los ejes, en cambio, se pliegan sobre el eje real.",
