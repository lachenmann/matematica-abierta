    },
    {
      "id": "deformacion",
      "texto": "A cada punto zeta le asignamos su cuadrado en el plano de salida.",
      "inicio": 12.66666667,
      "fin_voz": 16.685333336666666,
      "fin": 17.800000003333334,
      "audio": "generados\\audio\\cue-03-deformacion-em_alex.wav",
