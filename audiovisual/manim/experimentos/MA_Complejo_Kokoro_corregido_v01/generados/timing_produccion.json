    },
    {
      "id": "opuestos",
      "texto": "Dos puntos opuestos tienen el mismo cuadrado.",
      "inicio": 47.23333333,
      "fin_voz": 50.259333330000004,
      "fin": 50.76666666333333,
      "audio": "generados\\audio\\cue-10-opuestos-em_alex.wav",
